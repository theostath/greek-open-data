# data.gov.gr API bearer token (register on the portal). Never commit the real value.
# NOTE (Phase 1): the relaunched CKAN catalog + data access are anonymous; this is
# unused on the read path and kept only as a defensive placeholder.
DATA_GOV_GR_TOKEN=

# Anthropic API key — RAGAS dev-eval faithfulness scoring ONLY (ADR-0003/0004).
# The planning/synthesis LLM is local Qwen via Ollama (below); this key is never read
# on that path. Leave blank unless you run the RAGAS eval.
ANTHROPIC_API_KEY=

# Planning/synthesis LLM: local Qwen via Ollama's OpenAI-compatible API (ADR-0004).
# Requires `ollama serve` running and the model pulled (`ollama pull qwen3.5:9b`).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b

# Optional override of the portal base URL (verified in Phase 1).
DATA_GOV_GR_BASE_URL=https://data.gov.gr
